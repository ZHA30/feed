    "afc89c8e6c51eed2953ebfbe9a4f33742b8a385099e97108ee071f2530464b5a": {
      "feature": "translate",
      "sourceHash": "b1c34819969507a1ae8734254b547f6b4d6507571f38eb1cf908ef829bdf9b67",
